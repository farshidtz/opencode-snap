{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update anomalyco/opencode",
      "managerFilePatterns": [
        "^snap/snapcraft\\.yaml$"
      ],
      "matchStrings": [
        "https://github\\.com/anomalyco/opencode/releases/download/(?<currentValue>v[^/]+)/opencode-linux"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "anomalyco/opencode",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update anomalyco/opencode snap version",
      "managerFilePatterns": [
        "^snap/snapcraft\\.yaml$"
      ],
      "matchStrings": [
        "^version:\\s(?<currentValue>\\d+\\.\\d+\\.\\d+)$"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "anomalyco/opencode",
      "extractVersionTemplate": "^v(?<version>.+)$",
      "versioningTemplate": "semver"
    }
  ]
}
